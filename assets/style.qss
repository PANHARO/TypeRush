QMainWindow, QDialog {
    background: #0a0a0a;
    color: #dddddd;
}
QWidget { color: #dddddd; font-family: "Segoe UI"; font-size: 13px; }
QWidget#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #161616, stop:0.55 #0a0a0a, stop:1 #111111);
}
QLabel { background: transparent; border: none; }
QLabel#titleLabel { font-size: 46px; font-weight: 800; font-style: italic; }
QLabel#subtitleLabel { color: #aaaaaa; font-size: 9px; }
QLabel#brandBadge { color: #38d5f4; font-size: 40px; padding: 0 8px; }
QPushButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #242424,stop:1 #161616);
    border: 1px solid #444444;
    border-radius: 8px;
    padding: 12px 10px;
    color: #dddddd;
}
QPushButton:hover { border-color: #ffd600; background: #303030; }
QPushButton:pressed { background: #444444; }
QPushButton:focus { border-color: #ffd600; }
QPushButton:checked {
    background: #ffd600;
    border-color: #ffd600;
    color: #0a0a0a;
    font-weight: 600;
}
QWidget#durationPanel QPushButton { min-width: 54px; padding: 6px 9px; }
QWidget#durationPanel QPushButton:checked {
    background: #ffd600; color: #0a0a0a; border-color: #ffd600;
}
QLabel#durationLabel { padding-right: 12px; }
QFrame#wpmCard, QFrame#accuracyCard, QFrame#timeCard, QFrame#typingPanel {
    border: 1px solid #444444; border-radius: 9px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #202020,stop:1 #161616);
}
QFrame#wpmCard, QFrame#accuracyCard, QFrame#timeCard { min-height: 88px; }
QLabel#wpmIcon, QLabel#accuracyIcon, QLabel#timeIcon { font-size: 36px; padding: 0 8px; }
QLabel#wpmIcon, QLabel#accuracyIcon, QLabel#timeIcon { color: #ffd600; }
QLabel#wpmCaption, QLabel#accuracyCaption, QLabel#timeCaption { color: #aaaaaa; font-size: 12px; }
QLabel#wpmValue, QLabel#accuracyValue, QLabel#timeValue { font-size: 29px; font-weight: 700; }
QLabel#wpmValue, QLabel#accuracyValue, QLabel#timeValue { color: #ffd600; }
QLabel#wordsLabel { font-family: "Consolas", "Courier New"; font-size: 21px; }
QLineEdit {
    background: #111111; border: 1px solid #777777; border-radius: 7px;
    padding: 12px; color: #dddddd; font-size: 16px;
    selection-background-color: #ffd600; selection-color: #0a0a0a;
}
QLineEdit:focus { border: 1px solid #ffd600; }
QLineEdit[incorrect="true"] { border: 1px dashed #aaaaaa; }
QLineEdit:disabled { color: #888888; border-color: #444444; }
QProgressBar { background: #242424; border: 1px solid #444444; border-radius: 7px; height: 13px; max-height: 13px; }
QProgressBar::chunk { background: #ffd600; border-radius: 6px; }
QLabel#progressLabel { color: #bbbbbb; min-width: 88px; }
QLabel#statusLabel { color: #aaaaaa; font-size: 12px; min-height: 32px; }
QPushButton#restartButton, QPushButton#switchModeButton { min-height: 25px; font-size: 15px; font-weight: 600; }
QPushButton#restartButton { border-color: #777777; }
QPushButton#switchModeButton {
    background: #ffd600;
    border-color: #ffd600; color: #0a0a0a;
}
QPushButton#switchModeButton:hover { background: #ffe34d; }
QPushButton#switchModeButton:pressed { background: #e6c100; }
QTableWidget { background: #161616; alternate-background-color: #242424; border: 1px solid #444444; gridline-color: #444444; selection-background-color: #ffd600; selection-color: #0a0a0a; }
QHeaderView::section { background: #303030; color: #dddddd; padding: 8px; border: none; }
QTableCornerButton::section { background: #303030; border: none; }
QCheckBox { spacing: 10px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #777777; border-radius: 3px; background: #161616; }
QCheckBox::indicator:checked { background: #ffd600; border-color: #ffd600; }
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: #ffd600; }
